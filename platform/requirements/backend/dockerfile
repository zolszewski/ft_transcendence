FROM docker.io/library/node:22-bookworm

WORKDIR /app

COPY backend/package*.json ./

COPY backend/prisma ./prisma

RUN npm install

COPY backend/ ./

ENV MODEL_CACHE_DIR=/opt/model-cache

RUN npx tsx scripts/warm-model.ts

EXPOSE 4000

CMD ["sh", "-c", "node scripts/with-vault.js npx prisma migrate deploy && node scripts/with-vault.js npx tsx scripts/seed.ts && node scripts/with-vault.js npm run dev"]
