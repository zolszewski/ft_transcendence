### Create an account
POST {{baseUrl}}/api/auth/register
Content-Type: application/json

{
  "email": "dashboard@example.com",
  "name": "Dashboard",
  "password": "motdepasse123"
}

### Empty dashboard at first (all counters at 0, approvalRate null)
GET {{baseUrl}}/api/dashboard

### Create an article and submit it
# @name dashArticle
POST {{baseUrl}}/api/articles
Content-Type: application/json

{
  "title": "article dashboard",
  "content": "c"
}

###
POST {{baseUrl}}/api/articles/{{dashArticle.response.body.$.id}}/submit

### Create the "reviewer" account (replaces the current cookie)
POST {{baseUrl}}/api/auth/register
Content-Type: application/json

{
