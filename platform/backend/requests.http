### Create a "reviewer" account (replaces the current cookie)
POST {{baseUrl}}/api/auth/register
Content-Type: application/json

{
  "email": "queue-reviewer@example.com",
  "name": "QueueReviewer",
  "password": "motdepasse123"
}

### The article appears in the reviewer's queue
GET {{baseUrl}}/api/articles/submitted

### The reviewer reviews the article
POST {{baseUrl}}/api/articles/{{queueArticle.response.body.$.id}}/reviews
Content-Type: application/json

{
  "comment": "ok"
}

### The article disappears from their queue (already reviewed by them)
GET {{baseUrl}}/api/articles/submitted

### Log in again as the author (replaces the reviewer's cookie)
POST {{baseUrl}}/api/auth/login
Content-Type: application/json

{
  "email": "queue-author@example.com",
  "password": "motdepasse123"
}

### The author never sees their own article in the queue
GET {{baseUrl}}/api/articles/submitted

### No authentication (401 expected)
POST {{baseUrl}}/api/auth/logout

###
GET {{baseUrl}}/api/articles/submitted

