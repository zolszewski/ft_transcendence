@baseUrl = http://localhost:4000

### Health check
GET {{baseUrl}}/health

### ==========================================================
### DAY 05-06: authentication (register/login/logout) + session protected by requireAuth (/me)
### ==========================================================

### Create an account.
POST {{baseUrl}}/api/auth/register
Content-Type: application/json

{
  "email": "test@example.com",
  "name": "test",
  "password": "motdepasse123"
}

### Who is logged in (with the cookie)
GET {{baseUrl}}/api/auth/me

### Log out
POST {{baseUrl}}/api/auth/logout

### Check that we are no longer logged in (401)
GET {{baseUrl}}/api/auth/me

### Log in again with the right password
POST {{baseUrl}}/api/auth/login
Content-Type: application/json

{
  "email": "test@example.com",
  "password": "motdepasse123"
}

### Try with a wrong password (401)
POST {{baseUrl}}/api/auth/login
Content-Type: application/json

{
  "email": "test@example.com",
  "password": "mauvaismotdepasse"
}

### Try to create an account again with an email already taken (409)
POST {{baseUrl}}/api/auth/register
Content-Type: application/json

{
  "email": "test@example.com",
  "name": "Autre",
  "password": "autremotdepasse"
}

### ==========================================================
### DAY 07: reading articles. First there must be articles in the database, otherwise these tests return an empty list:
### docker compose -f platform/docker-compose.yml exec backend npx tsx src/script_test.ts
### ==========================================================

### List all articles
# @name listArticles
GET {{baseUrl}}/api/articles/explore

### See the details of the first article in the list above
GET {{baseUrl}}/api/articles/{{listArticles.response.body.$.0.id}}

### Try an id that does not exist (404 expected)
GET {{baseUrl}}/api/articles/id-inexistant

### ==========================================================
### DAY 08: create / update / delete an article, with ownership check (isOwner). Two accounts needed (owner +
### intruder): each register/login replaces the stored cookie with the one of the account that just logged in.
### ==========================================================

### Create an "owner" account
POST {{baseUrl}}/api/auth/register
Content-Type: application/json

{
  "email": "owner@example.com",
  "name": "Owner",
  "password": "motdepasse123"
}

### Create an article as the owner
# @name createArticle
POST {{baseUrl}}/api/articles
Content-Type: application/json

{
  "title": "Mon article",
  "content": "Contenu de test"
}

### Update your own article (200 expected)
PUT {{baseUrl}}/api/articles/{{createArticle.response.body.$.id}}
Content-Type: application/json

{
  "title": "Mon article modifié",
  "content": "Nouveau contenu"
}

### Create an "intruder" account (replaces the current cookie)
POST {{baseUrl}}/api/auth/register
Content-Type: application/json

{
  "email": "intruder@example.com",
  "name": "Intruder",
  "password": "motdepasse123"
}

### Try to update someone else's article (403 expected)
PUT {{baseUrl}}/api/articles/{{createArticle.response.body.$.id}}
Content-Type: application/json

{
  "title": "Piratage",
  "content": "Piratage"
}

### Try to delete someone else's article (403 expected)
DELETE {{baseUrl}}/api/articles/{{createArticle.response.body.$.id}}

### Log in again as the owner
POST {{baseUrl}}/api/auth/login
Content-Type: application/json

{
  "email": "owner@example.com",
  "password": "motdepasse123"
}

### Delete your own article (204 expected)
DELETE {{baseUrl}}/api/articles/{{createArticle.response.body.$.id}}

### Check that the article is gone (404 expected)
GET {{baseUrl}}/api/articles/{{createArticle.response.body.$.id}}

### ==========================================================
### DAY 09: submit an article for review (DRAFT -> SUBMITTED)
### ==========================================================

### Create an account
POST {{baseUrl}}/api/auth/register
Content-Type: application/json

{
  "email": "day9@example.com",
  "name": "Day9",
  "password": "motdepasse123"
}

### Create an article (DRAFT by default)
# @name createArticleDay9
POST {{baseUrl}}/api/articles
Content-Type: application/json

{
  "title": "Article à soumettre",
  "content": "Contenu"
}

### Submit as the owner (200 expected, status -> SUBMITTED)
POST {{baseUrl}}/api/articles/{{createArticleDay9.response.body.$.id}}/submit

### Submit a second time (409 expected, already SUBMITTED)
POST {{baseUrl}}/api/articles/{{createArticleDay9.response.body.$.id}}/submit

### Create an "intruder" account (replaces the current cookie)
POST {{baseUrl}}/api/auth/register
Content-Type: application/json

{
  "email": "intruder9@example.com",
  "name": "Intruder9",
  "password": "motdepasse123"
}

### Try to submit someone else's article (403 expected)
POST {{baseUrl}}/api/articles/{{createArticleDay9.response.body.$.id}}/submit

### Try to submit an id that does not exist (404 expected)
POST {{baseUrl}}/api/articles/id-inexistant/submit

### ==========================================================
### DAY 10: reviews. An article must be SUBMITTED to be reviewable,
### and you cannot review your own article or the same article twice.
### ==========================================================

### Create an "author" account
POST {{baseUrl}}/api/auth/register
Content-Type: application/json

{
  "email": "author10@example.com",
  "name": "Author10",
  "password": "motdepasse123"
}

### Create an article
# @name createArticleDay10
POST {{baseUrl}}/api/articles
Content-Type: application/json

{
  "title": "Article à reviewer",
  "content": "Contenu"
}

### Submit it for review
POST {{baseUrl}}/api/articles/{{createArticleDay10.response.body.$.id}}/submit

### The author tries to review their own article (403 expected)
POST {{baseUrl}}/api/articles/{{createArticleDay10.response.body.$.id}}/reviews
Content-Type: application/json

{
  "comment": "auto-review"
}

### Create a "reviewer" account (replaces the current cookie)
POST {{baseUrl}}/api/auth/register
Content-Type: application/json

{
  "email": "reviewer10@example.com",
  "name": "Reviewer10",
  "password": "motdepasse123"
}

### Review the article (201 expected)
POST {{baseUrl}}/api/articles/{{createArticleDay10.response.body.$.id}}/reviews
Content-Type: application/json

{
  "comment": "Bon article"
}

### Try to review it a second time (409 expected)
POST {{baseUrl}}/api/articles/{{createArticleDay10.response.body.$.id}}/reviews
Content-Type: application/json

{
  "comment": "encore"
}

### List the reviews of the article
GET {{baseUrl}}/api/articles/{{createArticleDay10.response.body.$.id}}/reviews

### ==========================================================
### DAY 11: review decision (approve/reject) + PUBLISHED filter
### on public routes. A SUBMITTED article is invisible
### publicly until a reviewer approves it, but stays visible to its author and to a potential reviewer
### (any logged-in account other than the author).
### ==========================================================

### Create an "author" account
POST {{baseUrl}}/api/auth/register
Content-Type: application/json

{
  "email": "author11@example.com",
  "name": "Author11",
  "password": "motdepasse123"
}

### Create an article
# @name createArticleDay11
POST {{baseUrl}}/api/articles
Content-Type: application/json

{
  "title": "Article à publier",
  "content": "Contenu"
}

### Submit it for review
POST {{baseUrl}}/api/articles/{{createArticleDay11.response.body.$.id}}/submit

### The author (still logged in at this point) can see their own SUBMITTED article (200 expected)
GET {{baseUrl}}/api/articles/{{createArticleDay11.response.body.$.id}}

### Logged out, the article stays invisible (404 expected)
POST {{baseUrl}}/api/auth/logout

###
GET {{baseUrl}}/api/articles/{{createArticleDay11.response.body.$.id}}

### Create a "reviewer" account (replaces the current cookie)
POST {{baseUrl}}/api/auth/register
Content-Type: application/json

{
  "email": "reviewer11@example.com",
  "name": "Reviewer11",
  "password": "motdepasse123"
}

### A logged-in third party (potential reviewer) can also see the SUBMITTED article (200 expected)
GET {{baseUrl}}/api/articles/{{createArticleDay11.response.body.$.id}}

### Review the article
# @name createReviewDay11
POST {{baseUrl}}/api/articles/{{createArticleDay11.response.body.$.id}}/reviews
Content-Type: application/json

{
  "comment": "À valider"
}

### Log in again as the author (replaces the reviewer's cookie)
POST {{baseUrl}}/api/auth/login
Content-Type: application/json

{
  "email": "author11@example.com",
  "password": "motdepasse123"
}

### The author (not the reviewer) tries to decide (403 expected)
PATCH {{baseUrl}}/api/reviews/{{createReviewDay11.response.body.$.id}}
Content-Type: application/json

{
  "decision": "APPROVED"
}

### Log in again as the reviewer (replaces the author's cookie)
POST {{baseUrl}}/api/auth/login
Content-Type: application/json

{
  "email": "reviewer11@example.com",
  "password": "motdepasse123"
}

### Try an invalid decision (400 expected)
PATCH {{baseUrl}}/api/reviews/{{createReviewDay11.response.body.$.id}}
Content-Type: application/json

{
  "decision": "MAYBE"
}

### Approve the review (200 expected, article -> PUBLISHED)
PATCH {{baseUrl}}/api/reviews/{{createReviewDay11.response.body.$.id}}
Content-Type: application/json

{
  "decision": "APPROVED"
}

### Try to decide again (409 expected)
PATCH {{baseUrl}}/api/reviews/{{createReviewDay11.response.body.$.id}}
Content-Type: application/json

{
  "decision": "REJECTED"
}

### Check that the article is now publicly visible (200 expected)
GET {{baseUrl}}/api/articles/{{createArticleDay11.response.body.$.id}}

### Check that it appears in the public listing
GET {{baseUrl}}/api/articles/explore

