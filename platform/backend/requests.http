Content-Type: application/json

{
  "email": "dashboard@example.com",
  "password": "motdepasse123"
}

### Author's dashboard: 1 PUBLISHED, approvalRate = 100
GET {{baseUrl}}/api/dashboard

### No auth (401)
POST {{baseUrl}}/api/auth/logout

###
GET {{baseUrl}}/api/dashboard


### ==========================================================
### DAY 25: optional 2FA (TOTP), turned on from the profile.
### The 6-digit code changes every 30s and this file can't generate it. To get one:
###   1. copy the "secret=..." param from the otpauthUrl the setup returns (or read twoFactorSecret in the DB)
###   2. from the project root:
###      docker compose -f platform/docker-compose.yml exec backend node -e "console.log(require('otplib').authenticator.generate('THE_SECRET'))"
###   3. paste the code into @totpCode below (redo it before EVERY request that uses it)
### Wrong codes / passwords count toward authLimiter (10 fails / 15 min / IP): if you get a 429, `make restart`.
### ==========================================================

@totpCode = 763533

### Create a dedicated account (409 if it already exists: skip to login)
POST {{baseUrl}}/api/auth/register
Content-Type: application/json

{
  "email": "twofa@example.com",
  "name": "twofa",
  "password": "motdepasse123"
}

### Profile: twoFactorEnabled = false
GET {{baseUrl}}/api/users/me

### Start setup: returns otpauthUrl + qrCode (data URL). Secret is stored but 2FA is NOT on yet
# @name twoFaSetup
POST {{baseUrl}}/api/users/me/2fa/setup

### Enable with a wrong code (400)
POST {{baseUrl}}/api/users/me/2fa/enable
Content-Type: application/json

{
  "code": "000000"
}

### Enable with a badly formatted code (400)
POST {{baseUrl}}/api/users/me/2fa/enable
Content-Type: application/json

{
  "code": "abc"
}

### Enable with a valid code (200, twoFactorEnabled: true) - update @totpCode first
POST {{baseUrl}}/api/users/me/2fa/enable
Content-Type: application/json

{
  "code": "{{totpCode}}"
}

### Profile: twoFactorEnabled = true
GET {{baseUrl}}/api/users/me

### Run setup again while 2FA is on (409)
POST {{baseUrl}}/api/users/me/2fa/setup

### Log out
POST {{baseUrl}}/api/auth/logout

### Right password: no session, expect { requires2fa: true }
POST {{baseUrl}}/api/auth/login
Content-Type: application/json

{
  "email": "twofa@example.com",
  "password": "motdepasse123"
}

### Should be 401: the pending state doesn't grant any access
GET {{baseUrl}}/api/auth/me

### 401 here too
GET {{baseUrl}}/api/dashboard

### Wrong code (401)
POST {{baseUrl}}/api/auth/login/2fa
Content-Type: application/json

{
  "code": "000000"
}

### Bad format (400)
POST {{baseUrl}}/api/auth/login/2fa
Content-Type: application/json

{
  "code": 123456
}

### Right code (200, session open) - update @totpCode first. If that code was already used in the last 30s, wait for the next one
POST {{baseUrl}}/api/auth/login/2fa
Content-Type: application/json

{
  "code": "{{totpCode}}"
}

### Now logged in (200)
GET {{baseUrl}}/api/auth/me

### Replay /login/2fa without logging in first: the pending state was consumed (401)
POST {{baseUrl}}/api/auth/login/2fa
Content-Type: application/json

{
  "code": "{{totpCode}}"
}

### Disable with a wrong password (401)
POST {{baseUrl}}/api/users/me/2fa/disable
Content-Type: application/json

{
  "password": "mauvaismotdepasse",
  "code": "{{totpCode}}"
}

### Disable with the right password but a wrong code (400)
POST {{baseUrl}}/api/users/me/2fa/disable
Content-Type: application/json

{
  "password": "motdepasse123",
  "code": "000000"
}

### Disable with both right (200, twoFactorEnabled: false) - update @totpCode first
POST {{baseUrl}}/api/users/me/2fa/disable
Content-Type: application/json

{
  "password": "motdepasse123",
  "code": "{{totpCode}}"
}

### Disable when 2FA is already off (400)
POST {{baseUrl}}/api/users/me/2fa/disable
Content-Type: application/json

{
  "password": "motdepasse123",
  "code": "{{totpCode}}"
}

### Log out then back in: regular login, no requires2fa
POST {{baseUrl}}/api/auth/logout

###
POST {{baseUrl}}/api/auth/login
Content-Type: application/json

{
  "email": "twofa@example.com",
  "password": "motdepasse123"
}

### No auth: setup refused (401)
POST {{baseUrl}}/api/auth/logout

###
POST {{baseUrl}}/api/users/me/2fa/setup


### ==========================================================
### ARTICLE DOCUMENT (PDF): the PDF always stays PRIVATE in the DB,
### access is computed on the fly via canViewArticle,
### same rule as the article's own visibility:
### PUBLISHED -> everyone, otherwise the author, or any
### logged-in user if SUBMITTED, otherwise nobody
###
### curl -c cA.txt -X POST http://localhost:4000/api/auth/register \
###   -H "Content-Type: application/json" \
###   -d '{"email":"docauthor@example.com","name":"author","password":"motdepasse123"}'
###
### curl -b cA.txt -X POST http://localhost:4000/api/uploads \
###   -F "file=@myfile.pdf;type=application/pdf"
### -> 201 { id, ... }: that's DOC_ID
###
### curl -b cA.txt -X POST http://localhost:4000/api/articles \
###   -H "Content-Type: application/json" \
###   -d '{"title":"Test doc","content":"contenu","documentId":"DOC_ID"}'
### -> 201 { id, ... }: that's the ART_ID to swap in below
###
### ==========================================================

### Author sees documentUrl even as a DRAFT (the PDF is theirs)
GET {{baseUrl}}/api/articles/REMPLACER_PAR_ART_ID

### Author downloads their own document as a DRAFT (200)
GET {{baseUrl}}/api/articles/REMPLACER_PAR_ART_ID/document

### Create a second "third party" account (replaces the current cookie)
POST {{baseUrl}}/api/auth/register
Content-Type: application/json

{
  "email": "doctiers@example.com",
  "name": "tiers",
  "password": "motdepasse123"
}

### Third party can't see the DRAFT article (404)
GET {{baseUrl}}/api/articles/REMPLACER_PAR_ART_ID

### Third party can't download a DRAFT's document (404)
GET {{baseUrl}}/api/articles/REMPLACER_PAR_ART_ID/document

### Log back in as the author to submit the article
POST {{baseUrl}}/api/auth/login
Content-Type: application/json

{
  "email": "docauthor@example.com",
  "password": "motdepasse123"
}

###
POST {{baseUrl}}/api/articles/REMPLACER_PAR_ART_ID/submit

### Log back in as the third party (now a potential reviewer since it's SUBMITTED)
POST {{baseUrl}}/api/auth/login
Content-Type: application/json

{
  "email": "doctiers@example.com",
  "password": "motdepasse123"
}

### Third party now sees documentUrl (SUBMITTED article)
GET {{baseUrl}}/api/articles/REMPLACER_PAR_ART_ID

### Third party downloads the document as SUBMITTED (200)
GET {{baseUrl}}/api/articles/REMPLACER_PAR_ART_ID/document

### Log out: make sure anonymous users can't see or download a SUBMITTED
POST {{baseUrl}}/api/auth/logout

### Anonymous, SUBMITTED article (404)
GET {{baseUrl}}/api/articles/REMPLACER_PAR_ART_ID

### Anonymous, downloading a SUBMITTED (404)
GET {{baseUrl}}/api/articles/REMPLACER_PAR_ART_ID/document

### Log back in as the third party to review and approve
POST {{baseUrl}}/api/auth/login
Content-Type: application/json

{
  "email": "doctiers@example.com",
  "password": "motdepasse123"
}

### @name docReview
POST {{baseUrl}}/api/articles/REMPLACER_PAR_ART_ID/reviews
Content-Type: application/json

{
  "comment": "ok"
}

###
PATCH {{baseUrl}}/api/reviews/{{docReview.response.body.$.id}}
Content-Type: application/json

{
  "decision": "APPROVED"
}

### Log out: the article is PUBLISHED, so the PDF should be public
POST {{baseUrl}}/api/auth/logout

### Anonymous downloads a PUBLISHED article's document (200)
GET {{baseUrl}}/api/articles/REMPLACER_PAR_ART_ID/document


### ==========================================================
### GET /users/search: search by name
### Case-insensitive, partial match, leaves the current user out.
### ==========================================================

### Create the account doing the search
POST {{baseUrl}}/api/auth/register
Content-Type: application/json

{
  "email": "searcher@example.com",
  "name": "Alice Searcher",
  "password": "motdepasse123"
}

### Create two target accounts + an unrelated one (cookie gets replaced each time,
### doesn't matter here since we don't use it)
POST {{baseUrl}}/api/auth/register
Content-Type: application/json

{
  "email": "target1@example.com",
  "name": "Bob Target",
  "password": "motdepasse123"
}

###
POST {{baseUrl}}/api/auth/register
Content-Type: application/json

{
  "email": "target2@example.com",
  "name": "Bobby Targetson",
  "password": "motdepasse123"
}

### Log back in as the searcher (cookie points to the last account created)
POST {{baseUrl}}/api/auth/login
Content-Type: application/json

{
  "email": "searcher@example.com",
  "password": "motdepasse123"
}

### Partial, case-insensitive: both "Bob..." expected
GET {{baseUrl}}/api/users/search?q=bob

### Search your own name: empty list (you're excluded)
GET {{baseUrl}}/api/users/search?q=alice

### q missing: [] expected (not a 500 - that was the "==!" bug, fixed)
GET {{baseUrl}}/api/users/search

### empty q: [] expected
GET {{baseUrl}}/api/users/search?q=

### No auth (401)
POST {{baseUrl}}/api/auth/logout

###
GET {{baseUrl}}/api/users/search?q=bob


### ==========================================================
### ARTICLE VIEW TRACKING: groundwork for behavior tracking
### for recommendations (ArticleView). One view = 1 row per
### (user, article), never duplicated (upsert), and only
### for a logged-in user on a PUBLISHED article.
###
### No route exposes ArticleView (not meant to be read
### by the client), so here we can only check the HTTP
### behavior (no error, same status). To really check
### a row gets created / isn't duplicated / is skipped for anonymous users,
### go through the DB:
###
### docker compose -f platform/docker-compose.yml exec postgresql \
###   psql -U academic -d academic -c 'SELECT * FROM "ArticleView";'
### ==========================================================

### Create the author and their article
POST {{baseUrl}}/api/auth/register
Content-Type: application/json

{
  "email": "viewauthor@example.com",
  "name": "author",
  "password": "motdepasse123"
}

### @name viewArticle
POST {{baseUrl}}/api/articles
Content-Type: application/json

{
  "title": "Vue test",
  "content": "contenu"
}

###
POST {{baseUrl}}/api/articles/{{viewArticle.response.body.$.id}}/submit

### Create the reader (replaces the cookie), who'll also review it to get it published
POST {{baseUrl}}/api/auth/register
Content-Type: application/json

{
  "email": "viewreader@example.com",
  "name": "reader",
  "password": "motdepasse123"
}

### @name viewReview
POST {{baseUrl}}/api/articles/{{viewArticle.response.body.$.id}}/reviews
Content-Type: application/json

{}

###
PATCH {{baseUrl}}/api/reviews/{{viewReview.response.body.$.id}}
Content-Type: application/json

{
  "decision": "APPROVED"
}

### Reader views the published article (200, one view saved in the DB)
GET {{baseUrl}}/api/articles/{{viewArticle.response.body.$.id}}

### Reload x2: still 200, but no new row in the DB (upsert)
GET {{baseUrl}}/api/articles/{{viewArticle.response.body.$.id}}

###
GET {{baseUrl}}/api/articles/{{viewArticle.response.body.$.id}}

### Anonymous views the same article (200, but no view saved - no session)
POST {{baseUrl}}/api/auth/logout

###
GET {{baseUrl}}/api/articles/{{viewArticle.response.body.$.id}}
